{
  "name": "ignore-and-exclude",
  "displayName": "Ignore & Exclude",
  "description": "Add files to .gitignore or .git/info/exclude straight from the Explorer context menu, and manage the entries from a sidebar view.",
  "version": "0.3.0",
  "publisher": "The-Fisher-Slopworks-Co",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Fisher-Slopworks-Co/ignore-and-exclude.git"
  },
  "bugs": {
    "url": "https://github.com/The-Fisher-Slopworks-Co/ignore-and-exclude/issues"
  },
  "homepage": "https://github.com/The-Fisher-Slopworks-Co/ignore-and-exclude#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "gitignore",
    "git",
    "exclude",
    "ignore",
    "scm",
    "vcs"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#22272e",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ignoreAndExclude.addToGitignore",
        "title": "Add to .gitignore",
        "category": "Ignore & Exclude"
      },
      {
        "command": "ignoreAndExclude.addToGitExclude",
        "title": "Add to .git/info/exclude",
        "category": "Ignore & Exclude"
      },
      {
        "command": "ignoreAndExclude.refreshView",
        "title": "Refresh",
        "category": "Ignore & Exclude",
        "icon": "$(refresh)"
      },
      {
        "command": "ignoreAndExclude.removeEntry",
        "title": "Remove Entry",
        "category": "Ignore & Exclude",
        "icon": "$(trash)"
      },
      {
        "command": "ignoreAndExclude.openIgnoreFile",
        "title": "Open Ignore File",
        "category": "Ignore & Exclude",
        "icon": "$(go-to-file)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "ignoreAndExclude.entries",
          "name": "Ignore & Exclude",
          "icon": "$(eye-closed)",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ignoreAndExclude.entries",
        "contents": "No ignore entries yet.\nRight-click a file or folder in the Explorer and choose \"Add to .gitignore\" or \"Add to .git/info/exclude\" — every entry of both files will show up here, with a checkbox to toggle it."
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ignoreAndExclude.addToGitignore",
          "when": "resourceScheme == file",
          "group": "9_ignoreAndExclude@1"
        },
        {
          "command": "ignoreAndExclude.addToGitExclude",
          "when": "resourceScheme == file",
          "group": "9_ignoreAndExclude@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "ignoreAndExclude.addToGitignore",
          "when": "resourceScheme == file",
          "group": "9_ignoreAndExclude@1"
        },
        {
          "command": "ignoreAndExclude.addToGitExclude",
          "when": "resourceScheme == file",
          "group": "9_ignoreAndExclude@2"
        }
      ],
      "commandPalette": [
        {
          "command": "ignoreAndExclude.addToGitignore",
          "when": "editorIsOpen"
        },
        {
          "command": "ignoreAndExclude.addToGitExclude",
          "when": "editorIsOpen"
        },
        {
          "command": "ignoreAndExclude.refreshView",
          "when": "false"
        },
        {
          "command": "ignoreAndExclude.removeEntry",
          "when": "false"
        },
        {
          "command": "ignoreAndExclude.openIgnoreFile",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "ignoreAndExclude.refreshView",
          "when": "view == ignoreAndExclude.entries",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ignoreAndExclude.openIgnoreFile",
          "when": "view == ignoreAndExclude.entries && viewItem == ignoreAndExclude.file",
          "group": "inline"
        },
        {
          "command": "ignoreAndExclude.removeEntry",
          "when": "view == ignoreAndExclude.entries && viewItem == ignoreAndExclude.entry",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "make:icon": "node scripts/make-icon.mjs",
    "check": "node scripts/check-pattern.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "npm run compile && node scripts/check-pattern.mjs && node scripts/smoke-test.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "prettier": "^3.9.10",
    "typescript": "^5.4.0"
  }
}
